''' ============================================================
''' PAGE 5: COMPONENT DIAGRAM — SYSTEM ARCHITECTURE
''' ============================================================
title System Architecture - Component Diagram

component "React Frontend\n(Integration Target)" as Frontend

node "FastAPI Application Server" {
    component "Authentication / JWT" as Auth
    component "DID / Identity Layer" as Identity
    component "Credential Service" as CredentialService
    component "Delegation Service" as DelegationService
    component "Trust Evaluation" as TrustService
    component "Authorization Engine" as AuthzEngine
    component "Audit Service" as AuditService
    component "Status List Service" as StatusListService
    
    component "Outbox Worker" as Outbox
    component "Fabric Adapter" as FabricAdapter
}

database "PostgreSQL" as Postgres
node "Hyperledger Fabric Network" as Fabric
node "External Organization / Verifier" as ExtOrg {
    component "External did:web infrastructure" as ExtDID
    component "External Bitstring Status List resolution" as ExtStatus
}

Frontend -> Auth : VP/JWT
Frontend -> Identity
Frontend -> CredentialService
Frontend -> DelegationService
Frontend -> TrustService

Auth --> Identity
CredentialService --> StatusListService
DelegationService --> Identity
AuthzEngine --> TrustService
AuthzEngine --> DelegationService
AuthzEngine --> AuditService

Auth --> Postgres
Identity --> Postgres
CredentialService --> Postgres
DelegationService --> Postgres
TrustService --> Postgres
AuditService --> Postgres
StatusListService --> Postgres
Outbox --> Postgres

Outbox -> FabricAdapter : Anchors payload
FabricAdapter -> Fabric : Submits transaction

CredentialService -> ExtDID : Resolves foreign DID
CredentialService -> ExtStatus : Resolves foreign Status List

newpage
''' ============================================================
''' PAGE 6: DEPLOYMENT DIAGRAM
''' ============================================================
title Deployment Model - Deployment Diagram

node "Client Device" {
    node "Browser" {
        component "React Frontend" as React
    }
}

node "Organization Application Server" {
    node "FastAPI Runtime" {
        component "FastAPI Backend Process" as Backend
        component "Background Outbox Worker" as Worker
    }
}

node "Database Server" {
    database "PostgreSQL (Operational DB)" as DB
}

node "Hyperledger Fabric Network" {
    component "Ordering Service" as Orderer
    node "Organization Peer" {
        component "Chaincode (Smart Contracts)" as CC
    }
}

node "Foreign Organization Infrastructure" {
    component "DID Web Server" as ForeignDID
    component "Status List API Server" as ForeignStatus
}

React -down-> Backend : HTTPS (REST / JSON)
Backend -down-> DB : TCP/IP (SQLAlchemy)
Worker -up-> DB : TCP/IP (Polling)
Worker -down-> Orderer : HTTPS (Fabric SDK/REST adapter)
Orderer -down-> CC : Consensus/Block delivery
Backend -right-> ForeignDID : HTTPS (GET /.well-known/did.json)
Backend -right-> ForeignStatus : HTTPS (GET status-list VC)

newpage
''' ============================================================
''' PAGE 7: STATE DIAGRAM — CREDENTIAL LIFECYCLE
''' ============================================================
title Credential Lifecycle - State Diagram

[*] -> CREATED : Issue Verifiable Credential

state CREATED {
  note "VC generated, JWT signed, stored in PostgreSQL.\nBitstring status index assigned." as N1
}

CREATED -> ACTIVE : Publish
state ACTIVE {
  note "Status List VC bit is 0.\nCryptographic verification succeeds." as N2
}

ACTIVE -> REVOKED : Revoke (Compromise / Policy)
state REVOKED {
  note "Status List VC bit set to 1.\nCryptographic verification fails." as N3
}

ACTIVE -> EXPIRED : Time passes (exp claim)
state EXPIRED {
  note "Expiration claim threshold reached." as N4
}

REVOKED -> [*]
EXPIRED -> [*]

newpage
''' ============================================================
''' PAGE 8: STATE DIAGRAM — DELEGATION LIFECYCLE
''' ============================================================
title Delegation Lifecycle - State Diagram

[*] -> ACTIVE : Issue Delegation\n(Assign Capabilities)

state ACTIVE {
  note "Delegation is valid and usable for Authorization Engine." as N1
}

ACTIVE -> REVOKED : Revoke (Manual/Policy)
state REVOKED {
  note "Delegation explicitly revoked.\nDelegationEvent logged." as N2
}

ACTIVE -> EXPIRED : Time passes (expires_at)
state EXPIRED {
  note "Delegation threshold reached." as N3
}

REVOKED -> [*]
EXPIRED -> [*]

newpage
''' ============================================================
''' PAGE 9: SECURITY / TRUST DECISION SEQUENCE
''' ============================================================
title Security / Trust Decision Sequence (Internal Authorization)

actor "Agent" as Agent
participant "FastAPI Auth/Context" as API
participant "Identity/DID Resolver" as DIDRes
participant "VC Verifier" as VCVer
participant "Status Verifier" as StatusVer
participant "Delegation Verifier" as DelVer
participant "Trust Service" as TrustSvc
participant "Authorization Engine" as Authz
participant "Audit Service" as AuditSvc

Agent -> API: Attempt Sensitive Operation (Bearer JWT)
API -> API: Extract Principal (sub)

API -> DIDRes: Resolve Agent DID Document
alt Invalid DID/Key
    DIDRes --> API: Resolution Failed / Key Missing
    API --> Agent: 401 Unauthorized
end

API -> VCVer: Verify VC & Cryptographic Signature
alt Invalid VC
    VCVer --> API: Signature Invalid
    API --> Agent: 403 Forbidden
end

API -> StatusVer: Verify Credential Status
StatusVer -> StatusVer: Fetch Bitstring Status List VC
alt Revoked Credential
    StatusVer --> API: Status: REVOKED
    API --> Agent: 403 Forbidden
end

API -> DelVer: Verify Delegation
alt Invalid Delegation
    DelVer --> API: Delegation Revoked/Expired
    API --> Agent: 403 Forbidden
end

API -> TrustSvc: Get Trust State (Agent ID)
TrustSvc --> API: t, u, rr

API -> Authz: Evaluate Context (Trust, Capabilities, Action)
alt Missing Capability or Insufficient Trust
    Authz --> API: DENY (Reason Code)
    API -> AuditSvc: Record Audit (DENY)
    API --> Agent: 403 Forbidden
else Trust > Required & Capability Present
    Authz --> API: ALLOW
    API -> AuditSvc: Record Audit (ALLOW)
    API --> Agent: Operation Success
end

@enduml
